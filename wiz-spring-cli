#!/usr/bin/env sh
set -eu

generator_jar="${WIZ_SPRING_JAR:-/opt/wiz-spring/wiz-spring.jar}"

if [ ! -f "$generator_jar" ] || [ ! -r "$generator_jar" ] || [ ! -s "$generator_jar" ]; then
    printf 'WIZ Spring generator jar is missing or unreadable: %s\n' "$generator_jar" >&2
    printf 'Build it with ./mvnw clean package or set WIZ_SPRING_JAR.\n' >&2
    exit 1
fi
if ! command -v java >/dev/null 2>&1; then
    printf 'Java was not found on PATH. WIZ Spring requires JDK 25 or newer.\n' >&2
    exit 1
fi

java_version=$(java -version 2>&1 | sed -n '1s/.*version "\([^"]*\)".*/\1/p')
java_major=${java_version%%.*}
if [ "$java_major" = "1" ]; then
    java_remainder=${java_version#*.}
    java_major=${java_remainder%%.*}
fi
case "$java_major" in
    ''|*[!0-9]*)
        printf 'Could not determine the Java version. WIZ Spring requires JDK 25 or newer.\n' >&2
        exit 1
        ;;
esac
if [ "$java_major" -lt 25 ]; then
    printf 'Java %s is too old. WIZ Spring requires JDK 25 or newer.\n' "$java_version" >&2
    exit 1
fi
exec java -jar "$generator_jar" "$@"
