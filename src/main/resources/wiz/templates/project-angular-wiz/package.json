{
  "name": "__WIZ_ARTIFACT_ID__",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0",
    "npm": ">=10.0.0"
  },
  "wiz": {
    "frontend": "__WIZ_FRONTEND__",
    "builderVersion": 1
  },
  "scripts": {
    "ng": "ng",
    "wizbuild": "node --env-file-if-exists=.env scripts/wizbuild.mjs",
    "wizwatch": "node --env-file-if-exists=.env scripts/wizwatch.mjs",
    "frontend:build": "npm run wizbuild",
    "frontend:watch": "npm run wizwatch",
    "backend:build": "node --env-file-if-exists=.env scripts/build-backend.mjs",
    "build": "node --env-file-if-exists=.env scripts/build.mjs",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "bundle": "node --env-file-if-exists=.env scripts/bundle.mjs",
    "test:wizbuild": "node --env-file-if-exists=.env --test scripts/wiz/compiler.test.mjs"
  },
  "dependencies": {
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/router": "22.1.4",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.4",
    "pug": "3.0.4",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
