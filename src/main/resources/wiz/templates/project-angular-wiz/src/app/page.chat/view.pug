section.page.chat-page
  header.page-heading
    div
      span.kicker SERVER-SENT EVENTS
      h1 Team chat
      p.muted 메시지를 보내면 연결된 브라우저가 Spring SSE 이벤트를 즉시 받습니다.
    span.connection-pill([class.online]="connected()")
      span.connection-dot
      | {{ connected() ? 'Live stream connected' : 'Connecting…' }}

  p.form-error(*ngIf="error()") {{ error() }}

  article.panel.chat-panel
    div.message-list
      div.message(*ngFor="let message of messages()", [class.mine]="message.authorId === currentUserId()")
        span.message-avatar {{ message.authorName.charAt(0) }}
        div.message-bubble
          div.message-meta
            strong {{ message.authorName }}
            span {{ format(message.sentAt) }}
          p {{ message.text }}
      div.empty-state(*ngIf="messages().length === 0") Start the first conversation.
    form.chat-form((submit)="send(); $event.preventDefault()")
      input(name="message", [(ngModel)]="draft", autocomplete="off", placeholder="Share an update with the team…", required)
      button.primary-button(type="submit", [disabled]="sending() || !draft.trim()") Send message
