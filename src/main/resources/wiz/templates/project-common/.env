# Default project configuration. Edit this file directly; exported variables take precedence.
# Keep secrets out of source control and inject them through the process environment instead.
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
APP_API_PREFIX=/api

# The sample application defaults to a persistent H2 database under ./data.
# APP_DATASOURCE_URL=jdbc:h2:file:./data/sample
# APP_DATASOURCE_USERNAME=sa
# APP_DATASOURCE_PASSWORD=

# Optional production overrides. The dev profile keeps API documentation enabled.
# SPRINGDOC_API_DOCS_ENABLED=false
# SPRINGDOC_SWAGGER_UI_ENABLED=false

# Docker Compose reverse-proxy settings.
APP_ARTIFACT=application.__WIZ_ARTIFACT_TYPE__
HTTP_PORT=80
BUNDLE_DIR=./bundle
