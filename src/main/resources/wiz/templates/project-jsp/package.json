{
  "name": "__WIZ_ARTIFACT_ID__",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=8.0.0"
  },
  "wiz": {
    "frontend": "jsp",
    "templateVersion": 1
  },
  "scripts": {
    "frontend:build": "node --env-file-if-exists=.env scripts/static-build.mjs jsp",
    "frontend:watch": "node --env-file-if-exists=.env scripts/static-watch.mjs jsp",
    "frontend:test": "node --env-file-if-exists=.env --test src/test/frontend/*.test.mjs",
    "backend:build": "node --env-file-if-exists=.env scripts/build-backend.mjs",
    "build": "node --env-file-if-exists=.env scripts/build.mjs",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "bundle": "node --env-file-if-exists=.env scripts/bundle.mjs"
  }
}
