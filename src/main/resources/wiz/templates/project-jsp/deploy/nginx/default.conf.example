map $http_upgrade $wiz_connection_upgrade {
    default upgrade;
    '' close;
}

map $uri $wiz_cache_control {
    default "no-cache, must-revalidate";
    "~*(?:^|/)[^/]+[-.][A-Za-z0-9_-]{8,}\.(?:css|js|mjs|png|jpg|jpeg|gif|svg|ico|woff2?)$" "public, max-age=604800, immutable";
}

server {
    listen 80;
    server_name _;

    location = /assets {
        return 308 /assets/;
    }

    # Copy bundle/public to this path, or change the path to your deployment root.
    location ^~ /assets/ {
        alias /srv/wiz/public/;
        add_header Cache-Control $wiz_cache_control always;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $wiz_connection_upgrade;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
}
