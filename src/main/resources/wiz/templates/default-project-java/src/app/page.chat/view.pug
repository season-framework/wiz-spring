section(class="flex h-full min-h-[calc(100vh-2rem)] flex-col gap-3 p-4 sm:p-6")
    div(class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-200 pb-3 dark:border-zinc-800")
        div
            h1(class="text-xl font-semibold text-gray-900 dark:text-zinc-50") {{'chat.title' | translate}}
            p(class="mt-1 text-[13px] text-gray-500 dark:text-zinc-400") {{'chat.room' | translate}}: {{room}}
        span(class="inline-flex h-7 items-center rounded-lg px-2.5 text-[12px] font-semibold", [ngClass]="statusClass()") {{('chat.status.' + status) | translate}}

    div(class="grid min-h-0 flex-1 grid-cols-1 gap-3 lg:grid-cols-[minmax(0,1fr)_220px]")
        div(class="flex min-h-[420px] flex-col overflow-hidden rounded-lg border border-gray-200 bg-white dark:border-zinc-800 dark:bg-zinc-950")
            div(class="flex-1 space-y-2 overflow-y-auto bg-gray-50 p-3 dark:bg-zinc-950/70")
                div(*ngIf="messages.length === 0", class="flex h-full items-center justify-center text-[13px] text-gray-400 dark:text-zinc-500")
                    | {{'chat.empty' | translate}}
                div(*ngFor="let message of messages; trackBy: trackByIndex", [ngClass]="messageClass(message)")
                    div(*ngIf="message.kind === 'system'") {{message.text}}
                    div(*ngIf="message.kind !== 'system'")
                        div(class="mb-1 flex items-center justify-between gap-2 text-[11px] opacity-80")
                            span(class="truncate font-semibold") {{message.name}}
                            span(class="shrink-0") {{displayTime(message)}}
                        p(class="whitespace-pre-wrap break-words text-[13px] leading-relaxed") {{message.text}}

            form(class="flex gap-2 border-t border-gray-200 bg-white p-3 dark:border-zinc-800 dark:bg-zinc-950", (submit)="send(); $event.preventDefault()")
                input(type="text",
                    name="messageText",
                    [(ngModel)]="messageText",
                    [placeholder]="'chat.placeholder' | translate",
                    class="h-10 min-w-0 flex-1 rounded-lg border border-gray-300 bg-white px-3 text-[13px] text-gray-900 outline-none transition focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100")
                button(type="submit",
                    [disabled]="status !== 'connected' || !messageText.trim()",
                    class="inline-flex h-10 items-center justify-center rounded-lg bg-indigo-600 px-4 text-[13px] font-semibold text-white transition hover:bg-indigo-500 disabled:cursor-not-allowed disabled:bg-gray-300 disabled:text-gray-500 dark:disabled:bg-zinc-800 dark:disabled:text-zinc-500")
                    | {{'chat.send' | translate}}

        aside(class="rounded-lg border border-gray-200 bg-white p-3 dark:border-zinc-800 dark:bg-zinc-950")
            h2(class="text-[13px] font-semibold text-gray-900 dark:text-zinc-100") {{'chat.panelTitle' | translate}}
            dl(class="mt-3 space-y-3 text-[12px]")
                div
                    dt(class="text-gray-400 dark:text-zinc-500") {{'chat.user' | translate}}
                    dd(class="mt-1 truncate font-medium text-gray-700 dark:text-zinc-200") {{service.auth.session?.name || service.auth.session?.email || 'Guest'}}
                div
                    dt(class="text-gray-400 dark:text-zinc-500") {{'chat.connection' | translate}}
                    dd(class="mt-1 font-medium text-gray-700 dark:text-zinc-200") {{('chat.status.' + status) | translate}}
